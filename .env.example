# Firebase 프로젝트 설정값 (Firebase 콘솔 > 프로젝트 설정 > 일반 에서 확인)
# 실제 배포 전까지는 비워두면 데모 값 + 로컬 에뮬레이터로 동작합니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# true: 로컬 Realtime Database 에뮬레이터(127.0.0.1:9000)에 연결
# false: 위에 입력한 실제 Firebase 프로젝트에 연결
VITE_USE_EMULATOR=true
